# fastlane Fastfile — Mac App Store distribution.
#
# No Matchfile (manual signing) and no gym (Nuitka builds the .app; the CI shell
# steps / sign_mas.sh sign it). fastlane only creates the ASC record, fetches the
# Mac App Store provisioning profile, and uploads the already-built MAS .pkg.
default_platform(:mac)

platform :mac do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],   # base64 -> decoded by fastlane
      is_key_content_base64: true,
    )
  end

  # One-time, run locally: create the ASC app record.
  lane :bootstrap do
    produce(
      app_identifier: ENV["MAS_BUNDLE_ID"],
      app_name: "Epic Report Generator",
      mac: true, platforms: ["osx"],
    )
  end

  # Fetch/refresh the Mac App Store provisioning profile (manual signing).
  #
  # With no explicit type, sigh fetches the App Store distribution profile —
  # correct for the Mac App Store. A provisioning profile references the
  # **Apple Distribution** (application) certificate only; the **Mac Installer
  # Distribution** cert is NOT part of the profile (it signs the .pkg later via
  # productbuild in build_pkg.sh), so sigh takes no installer-cert option here.
  lane :profile do
    sigh(
      api_key: asc_key,
      app_identifier: ENV["MAS_BUNDLE_ID"],
      platform: "macos",
      output_path: "build",
    )
  end

  # Upload an already-built, MAS-signed .pkg to TestFlight (internal testing).
  # app_platform must be "osx" — pilot defaults to "ios", which rejects a .pkg.
  lane :beta do
    pilot(
      api_key: asc_key,
      app_platform: "osx",
      pkg: ENV["MAS_PKG_PATH"],          # epic-report-generator-mas.pkg
      skip_waiting_for_build_processing: true,
    )
  end

  # Upload + submit for App Review (used once metadata is ready). Listing copy
  # (description / keywords / promotional text) is version-controlled under
  # fastlane/metadata/<locale>/. Screenshots stay managed by hand in App Store
  # Connect, so they are skipped here (and never wiped by an empty folder).
  lane :release do
    deliver(
      api_key: asc_key,
      pkg: ENV["MAS_PKG_PATH"],
      platform: "osx",
      metadata_path: "./fastlane/metadata",
      skip_screenshots: true,
      submit_for_review: false,          # flip to true when confident
      automatic_release: false,
      force: true,                        # skip HTML preview in CI
    )
  end
end
